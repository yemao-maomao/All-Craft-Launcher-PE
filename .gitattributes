# 本机 git 全局 core.autocrlf=true：显式声明文本/二进制策略，防止换行转换损坏脚本与二进制资源（历史教训）
* text=auto

# 脚本与源码统一 LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
gradlew text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制一律 binary，禁止 CRLF 转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jar binary
*.so binary
*.a binary
*.bin binary
*.xz binary
*.zip binary
*.gz binary
*.tar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
*.pem binary
*.der binary
*.wasm binary
*.db binary
*.apk binary
